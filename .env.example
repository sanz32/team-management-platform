# Copy to .env.local and fill in. Never commit real values.

# Discord OAuth (staff login and buyer identity on the public store)
# Register both redirect URIs in the Discord Developer Portal:
#   <origin>/api/auth/callback/discord
#   <origin>/api/boost/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Access control: Discord server and role required to sign in
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_REQUIRED_ROLE_ID=role_id_that_grants_access
DISCORD_RL_ROLE_ID=raid_leader_role_id
# Optional comma-separated Discord user IDs
EXTRA_ALLOWED_DISCORD_IDS=
FRIEND_DISCORD_IDS=

# Optional: bot token for DMs and display names (features degrade gracefully without it)
DISCORD_BOT_TOKEN=

# Optional: Discord webhooks for notifications
DISCORD_ROSTER_WEBHOOK_URL=
DISCORD_SPLITS_WEBHOOK_URL=
DISCORD_DAYOFF_WEBHOOK_URL=
DISCORD_POINTS_WEBHOOK_URL=

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=generate_a_random_secret
NEXTAUTH_URL=http://localhost:3000

# Supabase (server-side only; the secret key never reaches the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Blizzard Battle.net API
BLIZZARD_CLIENT_ID=your_blizzard_client_id
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret
BLIZZARD_REGION=us

# Warcraft Logs API
WCL_CLIENT_ID=your_wcl_client_id
WCL_CLIENT_SECRET=your_wcl_client_secret
WCL_GUILD_ID=your_wcl_guild_id

# Shared secrets for machine-to-machine endpoints (generate random values)
CRON_SECRET=generate_a_random_secret
BREAK_WATCHER_SECRET=generate_a_random_secret
# If unset, the schedule sync endpoint stays closed (503)
BOOST_SYNC_SECRET=

# Optional
BOOST_FALLBACK_RAIDER_NICKNAME=
DESKTOP_APP_DOWNLOAD_URL=
FRIEND_DASHBOARD_VIDEO_URL=
