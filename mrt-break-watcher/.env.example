# Full path to the WoW chat log (enable it in-game once with /chatlog)
CHAT_LOG_PATH=C:\Program Files (x86)\World of Warcraft\_retail_\Logs\Chat.log

# Portal URL, without trailing slash
PORTAL_URL=https://portal.example.com

# Same value as BREAK_WATCHER_SECRET on the portal
BREAK_SECRET=

# Optional: custom pattern for the MRT break message
# BREAK_MESSAGE_REGEX=break.*?(\d+)\s*(?:min)?

# Optional: polling interval in ms (default 2000)
# POLL_MS=2000
